{
  "name": "realworld-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright UI tests for RealWorld and API tests for API Challenges",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^23.5.0 || >=24.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:get": "playwright test --project=api --grep @get",
    "test:post": "playwright test --project=api --grep @post",
    "test:put": "playwright test --project=api --grep @put",
    "test:delete": "playwright test --project=api --grep @delete",
    "test:options": "playwright test --project=api --grep @options",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "test:ui-mode": "playwright test --ui",
    "test:list": "playwright test --list",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notify:telegram": "node src/notifications/send-telegram.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5"
  }
}
